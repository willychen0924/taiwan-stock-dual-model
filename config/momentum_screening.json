    "revenue_growth_floor": 0.0,
    "revenue_growth_target": 0.3,
    "revenue_acceleration_floor": -0.05,
    "revenue_acceleration_target": 0.15,
    "net_income_growth_floor": 0.0,
    "net_income_growth_target": 0.5,
    "margin_change_floor": -0.02,
    "margin_change_target": 0.05,
    "cash_conversion_floor": 0.0,
    "cash_conversion_target": 1.0,
    "liabilities_ratio_best": 0.3,
    "liabilities_ratio_worst": 0.75,
    "net_cash_ratio_floor": -0.2,
    "net_cash_ratio_target": 0.3,
    "per_best": 10.0,
    "per_worst": 50.0,
    "turnover_target_twd": 100000000
