    "quality": {
      "profitable_years": 5,
      "positive_fcf_years": 7,
      "cash_conversion": 5,
      "liabilities_ratio": 5,
      "net_cash_ratio": 3
    },
    "valuation_liquidity": {
      "sector_per_percentile": 6,
      "sector_pbr_percentile": 4,
      "absolute_per": 2,
      "turnover": 3
    }
  },
  "hard_gates": {
